# Spotify Web API app (client credentials).
# Create one at https://developer.spotify.com/dashboard
# Required only when a search is not already cached under raw/spotify/.
# `make match` with a complete cache does not read these.
# The separate Spotify track pilot can reuse the sp PKCE login instead;
# that flow needs no client secret here. See README.md.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional Discogs personal token: https://www.discogs.com/settings/developers
# Raises the API limit from about 25 requests/minute to about 60.
# Not used when raw/discogs/ already has the page or release file.
DISCOGS_TOKEN=

# Discogs username whose folder 0 (the whole collection) is fetched. Default: ajozi
# DISCOGS_USER=ajozi

# Qobuz catalogue enrichment PoC (local scripts only; never publish this token).
# From your own logged-in Qobuz browser session: developer tools > Network >
# an api.json request > X-User-Auth-Token request header. Treat it as a password.
# Replace if expired/revoked (HTTP 401). See docs/qobuz.md for setup and resume.
QOBUZ_USER_AUTH_TOKEN=

# Optional: only for the older scripts/qobuz_poc.py comparison client.
# This is an application ID issued by Qobuz, not your user session token.
# QOBUZ_APP_ID=
