rice":2.99,"master_id":530794,"master_url":"https://api.discogs.com/masters/530794","title":"Petrouchka","country":"US","released":"1955","notes":"Burlesque in Four Scenes (complete recording).\r\n\r\nCover Photo: Nijinsky as Petrouchka, Courtesy Roger Pryor Dodge Collection, Dance Section, New York Public Library\r\n\r\nLong Playing \r\nLiving Presence - High Fidelity\r\nMargin Control\r\n\r\n[Liner]\r\n\"Together with Stravinsky's  'Le Sacre du Printemps' (Mercury MG50030), Ravel's 'Daphnis and Chloë' (Mercury MG50046) and the Tchaikovsky dance masterpieces 'Swan Lake' (Mercury OL 3-102), 'Sleeping Beauty' (Mercury OL 3-103) and 'The Nutcracker' (Mercury OL 2-101), this disc of Stravinsky's Petrouchka takes its place among the series of definitive recorded documentations of ballet masterpieces undertaken by Antal Dorati and the Minneapolis Symphony Orchestra for Mercury Living Presence.\r\n\r\nRecorded during March of 1955 in the Northrop Memorial Auditorium on the University of Minnesota campus, this performance was taken with a single Telefunken microphone and with the orchestra seated in normal concert arrangement on the stage. A special study was made of the auditorium reverberation characteristic and its relationship to the illusion of presence in solo and ensemble texture before arriving at a decision regarding the final microphone placement and the stage area where the orchestra would be seated. In short, special pains were taken to achieve a maximum of tonal \"warmth\" with no loss in clarity of orchestral texture. We call attention also to the balance of the important solo piano part in the Russian Dance and Petrouchka's Room episodes midway in Side 1, as well as to the percussion and brass through the whole of In the Moor's Room (latter third of Side 1) and to the muted trumpets which signalize the return of Petrouchka's ghost at the conclusion of the ballet (end of Side 2).\"\r\n","released_formatted":"1955","identifiers":[{"type":"Matrix / Runout","value":"YMG 50058A  MF4"},{"type":"Matrix / Runout","value":"YMG 50058B  MF4"},{"type":"Matrix / Runout","value":"YMG 50058A MF6 I","description":"Side One Runout, Variant 1"},{"type":"Matrix / Runout","value":"YMG 50058B MF6 I","description":"Side Two Runout, Variant 1"}],"videos":[],"genres":["Classical"],"styles":["Modern","Ballet"],"tracklist":[{"position":"","type_":"index","title":"Petrouchka - Burlesque Scenes In Four Tableaux","duration":"","sub_tracks":[{"position":"A1","type_":"track","title":"I. The Shrovetide Fair; Russian Dance","duration":""},{"position":"A2","type_":"track","title":"II. In Petrouchka's Room","duration":""},{"position":"A3","type_":"track","title":"III. In The Moor's Room; Dance Of The Ballerina And The Moor","duration":""},{"position":"B1","type_":"track","title":"IV. Grand Carnival—Dance Of Gypsies, Coachmen And Grooms; The Maskers; Death Of Petrouchka","duration":""}]}],"extraartists":[{"name":"Antal Dorati","anv":"","join":"","role":"Conductor","tracks":"","id":834378,"resource_url":"https://api.discogs.com/artists/834378"},{"name":"Cyril Beaumont","anv":"","join":"","role":"Liner Notes","tracks":"","id":2542085,"resource_url":"https://api.discogs.com/artists/2542085"},{"name":"Minneapolis Symphony Orchestra","anv":"","join":"","role":"Orchestra","tracks":"","id":883641,"resource_url":"https://api.discogs.com/artists/883641"}],"images":[{"type":"primary","uri":"https://i.discogs.com/kjZV6lIOc_JfuIYICyUn8iE7cTA2cEaXMqheZgQlr9g/rs:fit/g:sm/q:90/h:593/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9SLTMyOTM4/NTUtMTM4Mzk1Mzk2/My03MTMxLmpwZWc.jpeg","resource_url":"https://i.discogs.com/kjZV6lIOc_JfuIYICyUn8iE7cTA2cEaXMqheZgQlr9g/rs:fit/g:sm/q:90/h:593/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9SLTMyOTM4/NTUtMTM4Mzk1Mzk2/My03MTMxLmpwZWc.jpeg","uri150":"https://i.discogs.com/AN21t143qVcG9Q6OV7Cau_aTmdcUl5HJvNxq6yLL6eo/rs:fit/g:sm/q:40/h:150/w:150/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9SLTMyOTM4/NTUtMTM4Mzk1Mzk2/My03MTMxLmpwZWc.jpeg","wi